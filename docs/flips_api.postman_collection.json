{
  "info": {
    "_postman_id": "flipss-id-api-collection-v1",
    "name": "Flipss.id Streaming API",
    "description": "Complete Postman Collection for Flipss.id backend (Express, MySQL2, Sequelize, CORS *, Cloudflare R2, JWT Auth, Packages, Subscriptions, Contents, Watchlist).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "packageId",
      "value": "",
      "type": "string"
    },
    {
      "key": "contentId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health & Docs",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        },
        {
          "name": "OpenAPI Swagger JSON",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api-docs.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api-docs.json"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Budi Santoso\",\n  \"email\": \"budi@flipss.id\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login User (Auto-saves token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "  pm.collectionVariables.set(\"token\", res.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@flipss.id\",\n  \"password\": \"demo1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Get Current Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Packages & Subscriptions",
      "item": [
        {
          "name": "List All Packages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/packages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "packages"
              ]
            }
          }
        },
        {
          "name": "Get Package by Slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/packages/ultra-4k",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "packages",
                "ultra-4k"
              ]
            }
          }
        },
        {
          "name": "Create Package (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Family Max 4K\",\n  \"slug\": \"family-max-4k\",\n  \"tagline\": \"Up to 6 profiles & 4K HDR Dolby Vision\",\n  \"priceMonthly\": 229000,\n  \"priceYearly\": 2290000,\n  \"resolution\": \"4K Ultra HD + HDR\",\n  \"maxDevices\": 6,\n  \"downloadsAllowed\": 10,\n  \"tierLevel\": 5,\n  \"features\": [\n    \"4K Ultra HD\",\n    \"6 Devices\",\n    \"Spatial Audio\",\n    \"Zero Ads\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/packages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "packages"
              ]
            }
          }
        },
        {
          "name": "Subscribe to Package",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"packageId\": \"{{packageId}}\",\n  \"billingCycle\": \"monthly\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/subscriptions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "subscriptions"
              ]
            }
          }
        },
        {
          "name": "Get My Active Subscription",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/subscriptions/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "subscriptions",
                "me"
              ]
            }
          }
        },
        {
          "name": "Cancel Subscription",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/subscriptions/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "subscriptions",
                "cancel"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Categories & Contents",
      "item": [
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categories"
              ]
            }
          }
        },
        {
          "name": "List Contents (Filterable)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/contents?page=1&limit=20&trending=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "contents"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "trending",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Get Content by Slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/contents/jakarta-noir-2034",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "contents",
                "jakarta-noir-2034"
              ]
            }
          }
        },
        {
          "name": "Create Content (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Neon Batavia\",\n  \"slug\": \"neon-batavia\",\n  \"synopsis\": \"A futuristic heist across Old Town Jakarta.\",\n  \"type\": \"movie\",\n  \"releaseYear\": 2026,\n  \"durationMinutes\": 118,\n  \"maturityRating\": \"16+\",\n  \"imdbRating\": 8.6,\n  \"genres\": [\n    \"Action\",\n    \"Sci-Fi\"\n  ],\n  \"cast\": [\n    \"Chicco Jerikho\",\n    \"Putri Marino\"\n  ],\n  \"posterUrl\": \"https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=600\",\n  \"backdropUrl\": \"https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=1600\",\n  \"isFeatured\": true,\n  \"isTrending\": true,\n  \"isOriginal\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/contents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "contents"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Watchlist (My List)",
      "item": [
        {
          "name": "Get My Watchlist",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/watchlist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "watchlist"
              ]
            }
          }
        },
        {
          "name": "Add to Watchlist",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contentId\": \"{{contentId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/watchlist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "watchlist"
              ]
            }
          }
        },
        {
          "name": "Update Watch Progress",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"progressSeconds\": 920\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/watchlist/{{contentId}}/progress",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "watchlist",
                "{{contentId}}",
                "progress"
              ]
            }
          }
        },
        {
          "name": "Remove from Watchlist",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/watchlist/{{contentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "watchlist",
                "{{contentId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Cloudflare R2 Storage",
      "item": [
        {
          "name": "Upload Poster / Media to R2 (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "folder",
                  "value": "posters",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/storage/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "storage",
                "upload"
              ]
            }
          }
        },
        {
          "name": "Generate Presigned Video Upload URL (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"jakarta-noir-4k.mp4\",\n  \"contentType\": \"video/mp4\",\n  \"folder\": \"videos\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/storage/presign-upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "storage",
                "presign-upload"
              ]
            }
          }
        },
        {
          "name": "Generate Presigned Stream URL",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/storage/presign-stream?key=videos/jakarta-noir-4k.mp4",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "storage",
                "presign-stream"
              ],
              "query": [
                {
                  "key": "key",
                  "value": "videos/jakarta-noir-4k.mp4"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Object from R2 (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"posters/example.jpg\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/storage/delete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "storage",
                "delete"
              ]
            }
          }
        }
      ]
    }
  ]
}